{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    "skipLibCheck": true,
    "types": [],

    "baseUrl": ".",
    "paths": { "/js/*": ["src/js/*"] },

    // The top of the strictness ladder, reached 2026-08-23. `strict` subsumes
    // noImplicitAny and strictNullChecks - both climbed separately first, so
    // each rung's errors stayed attributable - and adds strictFunctionTypes,
    // strictBindCallApply, strictPropertyInitialization, noImplicitThis,
    // alwaysStrict and useUnknownInCatchVariables.
    //
    // Two of those found real problems rather than noise:
    //   useUnknownInCatchVariables  `catch (e)` now yields `unknown` instead of
    //     `any`, which is correct - JavaScript lets you throw anything, so every
    //     `e.message` was an assumption. See errors.ts, and note that main.ts's
    //     restricted-document branch now uses catalog.ts's isRestrictedError
    //     predicate instead of duck-typing `.restricted` off a caught value.
    //   strictFunctionTypes  event-handler parameters are contravariant, so a
    //     handler annotated `(e: MouseEvent)` is NOT assignable where an
    //     EventListener is wanted. Every one of those handlers only called
    //     preventDefault(), so the annotation was simply over-specific.
    "strict": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["app/thirdpartyrenderer/**", "node_modules"]
}
