{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "/js/*": [
        "app/js/*"
      ]
    }
  },
  "include": [
    "app/svelte/**/*.js",
    "app/svelte/**/*.svelte"
  ],
  "exclude": [
    "node_modules",
    "app/build",
    "app/js",
    "app/dev",
    "app/thirdpartyrenderer"
  ]
}
