# Vendored third-party renderer libraries (bring-your-own).
# These are NOT part of the core; each is fetched locally and adapted by a facade
# in app/thirdpartyrenderer/. To render diagrams locally, place the library here
# (e.g. mermaid.min.js) and enable the plugin in config.json.
#
# This block used to claim excluding them preserved a "nothing but hand-written
# vanilla JS ships" guarantee. That is no longer true: app/build/islands.js is a
# COMMITTED, compiled bundle carrying the Svelte runtime. What excluding them
# still preserves is that no third-party library is vendored into the repository
# unreviewed - the compiled bundle is built from sources in app/svelte/ that are
# committed and reviewable. See SVELTE_UPLIFT_PLAN.md.
app/thirdpartyrenderer/*.min.js
.webdoc-index/
__pycache__/
.claude/

# Accounts: password hashes and group membership. Never commit this - the
# default location for config.json's auth.usersFile.
.webdoc-auth/

# Node tooling. The SERVER stays Python-stdlib-only; these are build-time only.
node_modules/
*.tsbuildinfo

# The e2e suite indexes its own fixture corpus; keep it out of the product index.
.webdoc-index-test/

# e2e server log written by tests/conftest.py
tests/.serve-e2e.log

# ---------------------------------------------------------------------------
# COMPILED OUTPUT. Everything below is generated by `npm run build` and is NOT
# committed - the sources are src/**/*.ts and app/svelte/**.
#
# That means a git clone alone will NOT run: app/index.html loads /js/main.js,
# which does not exist until the build has run. Two ways to get a runnable tree:
#   contributors  npm ci && npm run build
#   everyone else download the tarball attached to a GitHub release, which CI
#                 builds on tag and which needs only a Python interpreter
# See .github/workflows/ and docs/requirements/system.md (sys_9).
# ---------------------------------------------------------------------------
.vite/
app/js/
app/build/
app/dev/*.js
app/dev/*.d.ts
app/thirdpartyrenderer/mermaid.js
app/thirdpartyrenderer/mermaid.d.ts
